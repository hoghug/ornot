            "icon_size": 80,
            "icon_color": "#ffffff",
            "title": "ELDRIDGE FROM MV",
            "heading_font_size": "heading-small",
            "text": "<p><a href=\"https://www.strava.com/routes/3372678553593469728\" target=\"_blank\" title=\"https://www.strava.com/routes/3372678553593469728\">This dirt route rips down and through Hoo-Koo-E-Koo Fire Road before heading up Eldridge to the top! [route]</a></p>",
            "text_font_size": "body-medium",
            "heading_tag": "automatic"
          }
        },
        "icon_G38jyb": {
          "type": "icon",
          "settings": {
            "icon_name": "icon-trophy",
            "image": "shopify://shop_images/LAKES.png",
            "icon_size": 80,
            "icon_color": "#ffffff",
            "title": "THROUGH THE LAKES",
            "heading_font_size": "heading-small",
            "text": "<p><a href=\"https://www.strava.com/routes/3372679353272503968\" target=\"_blank\" title=\"https://www.strava.com/routes/3372679353272503968\">This lesser traveled dirt route takes you into Ross before climbing up Fish Grade and the north side of Tam. [route]</a></p>",
            "text_font_size": "body-medium",
            "heading_tag": "automatic"
          }
        }
