        },
        "text_QU6ppe": {
          "type": "text",
          "settings": {
            "text": "<p>Bring your punch card (and your Strava proof) to get your raffle tix (one ticket per ascent, per day). We have prizes from Silca, Ultradynamico, Hunt Wheels, Outershell, Pasta Supply Co., Calling in Sick, and so much more. Check-in starts at 5pm. Raffle at 7pm. Make sure you are Signed up (do it <a href=\"https://www.ornotbike.com/pages/tam-week-sign-up\" target=\"_blank\" title=\"https://www.ornotbike.com/pages/tam-week-sign-up\"><strong>HERE</strong></a>)</p>",
            "text_font_size": "body-medium",
            "padding_bottom": 16
          }
        },
