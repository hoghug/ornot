    "section_text_row_nFCGbH": {
      "type": "section-text-row",
      "blocks": {
        "icon_qLeVUq": {
          "type": "icon",
          "settings": {
            "icon_name": "icon-trophy",
            "image": "shopify://shop_images/FAVORITE.png",
            "icon_size": 80,
            "icon_color": "#ffffff",
            "title": "OUR FAVORITE, ORNOT",
            "heading_font_size": "heading-small",
            "text": "<p><a href=\"https://www.strava.com/routes/3372676060068364064\" target=\"_blank\" title=\"https://www.strava.com/routes/3372676060068364064\">60% of the time, there’s a 100% chance we take this route. It’s the most direct but also the fewest cars. [route]</a></p>",
            "text_font_size": "body-medium",
            "heading_tag": "automatic"
          }
        },
        "icon_LGNNfP": {
          "type": "icon",
          "settings": {
            "icon_name": "icon-location",
            "image": "shopify://shop_images/RRG.png",
            "icon_size": 80,
            "icon_color": "#ffffff",
            "title": "RAILROAD ALL THE WAY",
            "heading_font_size": "heading-small",
            "text": "<p><a href=\"https://www.strava.com/routes/3372677357766686496\" target=\"_blank\" title=\"https://www.strava.com/routes/3372677357766686496\">This is the classic dirt route up. Settle into cruise-mode and settle into the dirtiest climb up to West Peak. [route]</a></p>",
            "text_font_size": "body-medium",
            "heading_tag": "automatic"
          }
        },
        "icon_3jqfCJ": {
          "type": "icon",
          "settings": {
            "icon_name": "icon-chat",
            "image": "shopify://shop_images/ROAD.png",
            "icon_size": 80,
            "icon_color": "#ffffff",
            "title": "STRAIGHT UP ROAD",
            "heading_font_size": "heading-small",
            "text": "<p><a href=\"https://www.strava.com/routes/3372676512470242626\" target=\"_blank\" title=\"https://www.strava.com/routes/3372676512470242626\">Road rider’s delight. This is the Tam Slam route (or the Google Maps bike directions). Just like a climb in Le Tour, Ornot. [route]</a></p>",
            "text_font_size": "body-medium",
            "heading_tag": "automatic"
          }
        }
      },
