            "image": "shopify://shop_images/STINSON_f561941b-4cfc-43b7-a505-57df5839e372.png",
            "icon_size": 80,
            "icon_color": "#ffffff",
            "title": "STINSON BREAKFAST CLUB",
            "heading_font_size": "heading-small",
            "text": "<p><a href=\"https://www.strava.com/routes/3372677771783854752\" target=\"_blank\" title=\"https://www.strava.com/routes/3372677771783854752\">This road ride allows you to tackle Tam from the lowest elevation to the highest elevation with the least distance. [route]</a></p>",
            "text_font_size": "body-medium",
            "heading_tag": "automatic"
          }
        },
        "icon_MJLAgB": {
          "type": "icon",
          "settings": {
