":"heading-large","padding_bottom":16,"heading_tag":"automatic"}}},"block_order":["statement"],"disabled":true,"name":"Rich text","settings":{"align_text":"text-left","width":"wrapper","color_scheme":"","overlay_type":"disabled","padding_top":100,"padding_bottom":100}},"section_accordion_faq":{"type":"section-accordion-group","blocks":{"faq_heading":{"type":"heading","settings":{"title":"FAQ"}},"faq_polartec":{"type":"question","settings":{"default_open":false,"title":"What is Polartec® Power Grid®?","content":"<p>Power Grid is a fabric designed by Polaretec to to regulate body temperature. It performs comfortably from low 50° with a Micro Climate to 75° on its own.<\/p>","show_icon":false,"icon_name":"icon-award","icon_size":20,"icon_color":""}},"faq_temp":{"type":"question","settings":{"default_open":false,"title":"What temperature is the Micro Grid Jersey designed for?","content":"<p>The Micro Grid Jersey is comfortable up to 78° on its own. Paired with an outer layer, the Jersey is comfortable into the mid-50’s.<\/p>","show_icon":false,"icon_name":"icon-award","icon_size":20,"icon_color":""}},"faq_winter":{"type":"question","settings":{"default_open":false,"title":"Is the Micro Grid Jersey warm enough for Winter?","content":"<p>The Short Sleeve Micro Grid Jersey might be a little chilly, but we do offer a Long Sleeve option. When paired with a Magic Shell and\/or an Alpha Vest, the Micro Grid Jersey is the foundation to a solid winter layering system.<\/p>","show_icon":false,"icon_name":"icon-award","icon_size":20,"icon_color":""}},"faq_fit":{"type":"question","settings":{"default_open":false,"title":"How does the Micro Grid Jersey fit?","content":"<p>The Micro Grid Jersey is true to size. This year we modernized the fit with slightly longer sleeves, and a touch more compression to take full advantage of the fabric benefits. We think it’s the best one yet.<\/p>","show_icon":false,"icon_name":"icon-award","icon_size":20,"icon_color":""}},"faq_made":{"type":"question","settings":{"default_open":false,"title":"Where is the Micro Grid Jersey made?","content":"<p>The Micro Grid Jersey is Made in USA. Specifically, we cut and sew it across the Bay in Oakland.<\/p>","show_icon":false,"icon_name":"icon-award","icon_size":20,"icon_color":""}},"faq_deadstock":{"type":"question","settings":{"default_open":false,"title":"What does “Deadstock” Mean?","content":"<p>Deadstock is fabric that was overproduced, abandoned, or never made it to the cutting table. Instead of letting it sit in a warehouse (or worse), we turn it into something new. The catch? We only get one shot. One opportunity. Same Polartec Delta performance, lower environmental impact.<\/p>","show_icon":false,"icon_name":"icon-award","icon_size":20,"icon_color":""}},"question_cwUAgp":{"type":"question","settings":{"default_open":false,"title":"What is the “Special Projects” collection?","content":"<p>One of the most sustainable things we can do is use what already exists. Special Projects is our collection of limited-run pieces made from premium deadstock fabrics, cut and sewn in California. Some of our most beloved pieces were born this way. When they're gone, they're gone.<\/p>","show_icon":false,"icon_name":"icon-award","icon_size":20,"icon_color":""}}},"block_order":["faq_heading","faq_polartec","faq_temp","faq_winter","faq_fit","faq_made","faq_deadstock","question_cwUAgp"],"name":"Accordion group","settings":{"show_faq_schema":false,"heading_font_size":"heading-medium","question_font_size":"heading-small","width":"wrapper","columns":"1","color_scheme":"","padding_top":50,"padding_bottom":50}},"section_hero_gPFQER":{"type":"section-hero","blocks":{"button_TnyRa3":{"type":"button","settings":{"link_text":"DISCOVER MORE SPECIAL PROJECTS","link":"shopify:\/\/collections\/special-projects","button_type":"btn--black","button_size":"btn--small","button_style":"btn--solid","show_arrow":false,"full_width":false,"padding_bottom":0}}},"block_order":["button_TnyRa3"],"name":"Image 