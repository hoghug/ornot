ize":"body-medium","button_text":"","button_url":"","button_type":"btn--primary","button_size":"","button_style":"btn--solid","show_arrow":false,"image_aspect_ratio":1,"mobile_image_aspect_ratio":1,"heading_tag":"automatic"}},"col_made":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/Ornot_Jersey_MicroGrid_Womens_SeaFoam_07.jpg","image_width":100,"image_shape":"normal","title":"COLOR","heading_font_size":"heading-small","text":"<p>Each of our colors are limited in nature. Micro Grid Jerseys are always made from Deadstock fabrics. If you like this color (Sea Foam) you should not wait.<\/p>","text_font_size":"body-medium","button_text":"","button_url":"","button_type":"btn--primary","button_size":"","button_style":"btn--solid","show_arrow":false,"image_aspect_ratio":1,"mobile_image_aspect_ratio":1,"heading_tag":"automatic"}},"col_temps":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/Ornot_Mens_Micro_Grid_Charcoal_06.jpg","image_width":100,"image_shape":"normal","title":"TEMPERATURE","heading_font_size":"heading-small","text":"<p>We ride in this year-round. It’s comfortable up to 78° on its own. In the Winter, we choose for the LS version, and comfortably ride in the mid 50’s with an outer layer.<\/p>","text_font_size":"body-medium","button_text":"","button_url":"","button_type":"btn--primary","button_size":"","button_style":"btn--solid","show_arrow":false,"image_aspect_ratio":1,"mobile_image_aspect_ratio":1,"heading_tag":"automatic"}}},"block_order":["col_fabric","col_made","col_temps"],"name":"Text columns with images","settings":{"title":"","heading_font_size":"heading-medium","align_heading":"text-left","align_text":"text-left","width":"wrapper--full-padded","align_columns":"flex-align-top","layout":"grid","grid":3,"layout_mobile":"slider","color_scheme":"","padding_top":50,"padding_bottom":50,"heading_tag":"automatic"}},"section_custom_content_grid":{"type":"section-custom-content","blocks":{"grid_img":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/Ornot_Mens_Micro_Grid_Charcoal_10.jpg","title":"","heading_font_size":"heading-large","text":"","text_font_size":"body-medium","flex_align":"align--middle-center","show_text_background":false,"bg_color":"","color":"#ffffff","overlay_type":"disabled","link_text":"","link":"","button_type":"btn--primary","button_size":"","button_style":"btn--solid","show_arrow":false,"heading_tag":"automatic"}},"grid_txt":{"type":"text","settings":{"subheading":"ORNOT","title":"NO ONE ELSE","heading_font_size":"heading-large","text":"<p>We pioneered the first, and only, Micro Grid Jersey in 2020. Since then, its remained unique to us. Spend enough time around the team, and you’ll see this is far and away our favorite jersey. It’s so versatile that it’s basically two jerseys in one.<\/p>","text_font_size":"body-medium","button_text":"SHOP MICRO GRID","button_url":"shopify:\/\/collections\/fabric-story-micro-grid","button_type":"btn--primary","button_size":"","button_style":"btn--solid","show_arrow":false,"button_text_2":"","button_url_2":"","button_type_2":"btn--primary","button_size_2":"","button_style_2":"btn--outline","show_arrow_2":false,"show_social_links":false,"text_columns":1,"align_text":"text-left","bg_color":"","color":"","heading_tag":"automatic"}}},"block_order":["grid_img","grid_txt"],"settings":{"borders":false,"gutters":false,"width":"wrapper--full","height":"image-height","mobile_height":"image-height--mobile","reverse_blocks":true,"color_scheme":"","padding_top":0,"padding_bottom":0}},"section_custom_content_mtN7L9":{"type":"section-custom-content","blocks":{"text_DPyUCG":{"type":"text","settings":{"subheading":"\/\/\/\/\/\/\/\/\/\/\/\/","title":"BORN IN THE BAY","heading_font_size":"heading-large","text":"<p>To wear the Micro Grid Jersey is to understand what it’s like to ride bikes in the Bay Area. Climbs are hot and exposed, then rewarded with steep and fast descents through the Redwoods. It’s not unusual to take off and put on an outer layer for each climb\/descent. The Micro Grid Jersey was made for the Bay.<\/p>","text_font_size":"body-medium","button_text":"SHOP MICRO GRID","button_url":"shopify:\/\/collections\/fabric-story-micro-grid","button_type":"btn--primary","button_size":"","button_style":"btn--solid","show_arrow":false,"button_text_2":"","button_url_2":"","button_type_2":"btn--primary","button_size_2":"","button_style_2":"btn--outline","show_arrow_2":false,"show_social_links":false,"text_columns":1,"align_text":"text-left","bg_color":"","color":"","heading_tag":"automatic"}},"image_GHAAHx":{"type":"image","settings":{"image":"shopify:\/\/shop_images\/Micro_Grid_Jersey_Square_03.jpg","title":"","heading_font_size":"heading-large","text":"","text_font_size":"body-medium","flex_align":"align--middle-center","show_text_background":false,"bg_color":"","color":"#ffffff","overlay_type":"disabled","link_text":"","link":"","button_type":"btn--primary","button_size":"","button_style":"btn--solid","show_arrow":false,"heading_tag":"automatic"}}},"block_order":["text_DPyUCG","image_GHAAHx"],"settings":{"borders":false,"gutters":false,"width":"wrapper--full","height":"image-height","mobile_height":"image-height--mobile","reverse_blocks":true,"color_scheme":"","padding_top":0,"padding_bottom":0}},"section_custom_content_temps":{"type":"section-custom-content","blocks":{"temp_txt":{"type":"text","settings":{"subheading":"","title":"one jersey, two seasons","heading_font_size":"heading-large","text":"<p>We wear this on its own from the mid 70s into the mid 80s. Add a Micro Climate Jacket or a wind vest and it keeps working down into the mid 50s.<\/p><p>It dries fast, so a hard climb followed by a cold descent does not leave you in a wet jersey.<\/p>","text_font_size":"body-medium","button_text":"","button_url":"","button_type":"btn--primary","button_size":"","button_style":"btn--solid","show_arrow":false,"button_text_2":"","button_url_2":"","button_type_2":"btn--primary","button_size_2":"","button_sty