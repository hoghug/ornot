<!-- /sections/section-video-banner.liquid -->

{%- liquid
  assign s = section.settings

  assign has_video = false
  if s.video != null or s.mobile_video != null
    assign has_video = true
  endif

  case s.content_position
    when 'top-left'
      assign align_y = 'flex-start'
      assign align_x = 'flex-start'
    when 'top-center'
      assign align_y = 'flex-start'
      assign align_x = 'center'
    when 'top-right'
      assign align_y = 'flex-start'
      assign align_x = 'flex-end'
    when 'middle-left'
      assign align_y = 'center'
      assign align_x = 'flex-start'
    when 'middle-center'
      assign align_y = 'center'
      assign align_x = 'center'
    when 'middle-right'
      assign align_y = 'center'
      assign align_x = 'flex-end'
    when 'bottom-center'
      assign align_y = 'flex-end'
      assign align_x = 'center'
    when 'bottom-right'
      assign align_y = 'flex-end'
      assign align_x = 'flex-end'
    else
      assign align_y = 'flex-end'
      assign align_x = 'flex-start'
  endcase

  case s.content_position_mobile
    when 'top-left'
      assign align_y_m = 'flex-start'
      assign align_x_m = 'flex-start'
    when 'top-center'
      assign align_y_m = 'flex-start'
      assign align_x_m = 'center'
    when 'middle-left'
      assign align_y_m = 'center'
      assign align_x_m = 'flex-start'
    when 'middle-center'
      assign align_y_m = 'center'
      assign align_x_m = 'center'
    when 'bottom-center'
      assign align_y_m = 'flex-end'
      assign align_x_m = 'center'
    else
      assign align_y_m = 'flex-end'
      assign align_x_m = 'flex-start'
  endcase

  assign text_flex = 'flex-start'
  if s.text_align == 'center'
    assign text_flex = 'center'
  elsif s.text_align == 'right'
    assign text_flex = 'flex-end'
  endif

  assign text_flex_m = 'flex-start'
  if s.text_align_mobile == 'center'
    assign text_flex_m = 'center'
  elsif s.text_align_mobile == 'right'
    assign text_flex_m = 'flex-end'
  endif

  assign wrapper_classes = 'video-banner ' | append: s.width
  if s.aspect_desktop == 'full'
    assign wrapper_classes = wrapper_classes | append: ' video-banner--fullheight-d'
  endif
  if s.aspect_mobile == 'full'
    assign wrapper_classes = wrapper_classes | append: ' video-banner--fullheight-m'
  endif
  if s.stack_text_mobile
    assign wrapper_classes = wrapper_classes | append: ' video-banner--stack-mobile'
  endif
  if s.buttons_full_mobile
    assign wrapper_classes = wrapper_classes | append: ' video-banner--buttons-full'
  endif
-%}

{{ 'video-banner.css' | asset_url | stylesheet_tag }}
{%- if has_video -%}
  <script src="{{ 'video-banner.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- capture banner_style -%}
  --PT: {{ s.padding_top }}px;
  --PB: {{ s.padding_bottom }}px;
  --vb-align-y: {{ align_y }};
  --vb-align-x: {{ align_x }};
  --vb-align-y-m: {{ align_y_m }};
  --vb-align-x-m: {{ align_x_m }};
  --vb-text-align: {{ s.text_align }};
  --vb-text-align-m: {{ s.text_align_mobile }};
  --vb-text-align-flex: {{ text_flex }};
  --vb-text-align-flex-m: {{ text_flex_m }};
  --vb-content-width: {{ s.content_width }}%;
  {%- unless s.aspect_desktop == 'full' -%}
    --vb-aspect-d: {{ s.aspect_desktop }};
  {%- endunless -%}
  {%- unless s.aspect_mobile == 'full' -%}
    --vb-aspect-m: {{ s.aspect_mobile }};
  {%- endunless -%}
  {%- unless s.text_color.alpha == 0.0 or s.text_color == blank -%}
    --vb-text: {{ s.text_color }};
  {%- endunless -%}
  {%- unless s.stack_bg_color.alpha == 0.0 or s.stack_bg_color == blank -%}
    --vb-stack-bg: {{ s.stack_bg_color }};
  {%- endunless -%}
  {%- unless s.stack_text_color.alpha == 0.0 or s.stack_text_color == blank -%}
    --vb-stack-text: {{ s.stack_text_color }};
  {%- endunless -%}
{%- endcapture -%}

<section
  id="VideoBanner--{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="video-banner"
  class="section-padding color-{{ s.color_scheme }}"
  {% if s.overlay_header %}
    data-overlay-header
  {% endif %}
  style="{{ banner_style }}"
>
  <div class="{{ wrapper_classes }}">
    <div class="video-banner__frame">
      <div class="video-banner__media">
        {%- if s.image != blank or s.mobile_image != blank -%}
          <picture>
            {%- if s.mobile_image != blank -%}
              <source
                media="(max-width: 749px)"
                srcset="{{ s.mobile_image | image_url: width: 1200 }} 1200w, {{ s.mobile_image | image_url: width: 900 }} 900w, {{ s.mobile_image | image_url: width: 600 }} 600w"
                sizes="100vw"
              >
            {%- endif -%}
            {%- assign poster = s.image | default: s.mobile_image -%}
            <img
              class="video-banner__poster"
              src="{{ poster | image_url: width: 1600 }}"
              srcset="{{ poster | image_url: width: 2400 }} 2400w, {{ poster | image_url: width: 1800 }} 1800w, {{ poster | image_url: width: 1200 }} 1200w"
              sizes="100vw"
              width="{{ poster.width }}"
              height="{{ poster.height }}"
              alt="{{ poster.alt | escape }}"
              loading="{% if s.eager_load %}eager{% else %}lazy{% endif %}"
            >
          </picture>
        {%- endif -%}

        {%- if has_video -%}
          <video-banner-media class="video-banner__player">
            {%- if s.video != null -%}
              <template data-video="desktop">
                {{ s.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '1600x' }}
              </template>
            {%- endif -%}
            {%- if s.mobile_video != null -%}
              <template data-video="mobile">
                {{ s.mobile_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, image_size: '900x' }}
              </template>
            {%- endif -%}
          </video-banner-media>
        {%- endif -%}
      </div>

      {%- render 'video-banner-content', section: section -%}
    </div>
  </div>
</section>

