<!-- /sections/section-split-media.liquid -->

{%- liquid
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign selected_color_scheme = section.settings.color_scheme | strip
  assign scheme_bg_color = settings.color_schemes[selected_color_scheme].settings.section_bg
  assign animation_anchor = '#SplitMedia--' | append: section.id

  assign border_class = ''
  if section.settings.borders
    assign border_class = 'brick--border'
  endif

  assign transparent_header = false
  assign non_image_block_types = 'text' | split: ','
  unless non_image_block_types contains section.blocks[0].type and non_image_block_types contains section.blocks[1].type
    assign transparent_header = true
  endunless

  assign show_video_background = false
  assign video_blocks = section.blocks | where: 'type', 'video'
  for video_block in video_blocks
    if video_block.settings.video != null
      assign show_video_background = true
    endif
  endfor

  comment
    Height of the media half on mobile, as a CSS value. The Text block's
    "Type block height" setting (half / full) is measured against this.
  endcomment
  assign mobile_media_height = 'var(--one-half)'
  case section.settings.mobile_height
    when 'screen-height-full--mobile'
      assign mobile_media_height = 'var(--full-height)'
    when 'screen-height-three-quarters--mobile'
      assign mobile_media_height = 'var(--three-quarters)'
    when 'screen-height-two-thirds--mobile'
      assign mobile_media_height = 'var(--two-thirds)'
    when 'screen-height-one-half--mobile'
      assign mobile_media_height = 'var(--one-half)'
    when 'screen-height-one-third--mobile'
      assign mobile_media_height = 'var(--one-third)'
    when 'seven-fifty-height-hero--mobile'
      assign mobile_media_height = '750px'
    when 'sixty-fifty-height-hero--mobile'
      assign mobile_media_height = '650px'
    when 'five-fifty-height-hero--mobile'
      assign mobile_media_height = '550px'
    when 'four-fifty-height-hero--mobile'
      assign mobile_media_height = '450px'
    when 'image-height--mobile'
      assign media_ratio = 1
      for media_block in section.blocks
        if media_block.type == 'image'
          assign media_ratio = media_block.settings.mobile_image.aspect_ratio | default: media_block.settings.image.aspect_ratio | default: 1
          break
        elsif media_block.type == 'video'
          assign media_ratio = media_block.settings.video.aspect_ratio | default: 1
          break
        endif
      endfor
      if section.settings.width == 'wrapper--full'
        assign mobile_media_height = 'calc(100vw / ' | append: media_ratio | append: ')'
      else
        assign mobile_media_height = 'calc((100vw - var(--outer) * 2) / ' | append: media_ratio | append: ')'
      endif
  endcase
-%}

{%- if show_video_background -%}
  <script src="{{ 'video-background.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{{ 'split-media.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #SplitMedia--{{ section.id }} {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;
    --split-media-mobile-height: {{ mobile_media_height }};
  }
{%- endstyle -%}

<section
  id="SplitMedia--{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="split-media"
  {% if transparent_header %}
    data-overlay-header
  {% endif %}
  class="section-padding {{ color_scheme }}"
>
  {%- if section.blocks.size > 0 -%}
    <div class="brick__section split-media__section{% if section.settings.reverse_desktop %} brick__section--reversed{% endif %}{% if section.settings.reverse_mobile %} brick__section--reversed-mobile{% endif %}{% if section.settings.gutters %} brick--margin{% endif %} {{ border_class }} {{ section.settings.width }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign bg_color = block.settings.bg_color | default: scheme_bg_color
          assign text_color = block.settings.color
          assign padding_class = ''
          assign color_difference = bg_color | color_difference: scheme_bg_color

          if bg_color != 'rgba(0,0,0,0)' and color_difference > 10
            assign padding_class = ' has-padding'
          endif
        -%}

        {%- capture style -%}
          {%- unless bg_color.alpha == 0.0 or bg_color == blank -%}
            --bg: {{ bg_color }};
          {%- endunless -%}

          {%- unless text_color.alpha == 0.0 or text_color == blank -%}
            --text: {{ text_color }};
            --text-light: {{ text_color | color_mix: bg_color, 70 }};
            --text-dark: {{ text_color | color_saturate: 10 | color_darken: 15 }};
          {%- endunless -%}
        {%- endcapture -%}

        {%- case block.type -%}
          {%- when 'video' -%}
            {%- render 'split-media-video',
              block: block,
              style: style,
              animation_anchor: animation_anchor
            -%}

          {%- when 'image' -%}
            {%- render 'split-media-image',
              block: block,
              style: style,
              animation_anchor: animation_anchor
            -%}

          {%- when 'text' -%}
            {%- render 'split-media-text',
              block: block,
              style: style,
              padding_class: padding_class,
              animation_anchor: animation_anchor
            -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

